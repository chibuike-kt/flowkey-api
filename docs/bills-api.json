    "/bills/electricity/verify": {
      "post": {
        "tags": ["Bills — Electricity"],
        "operationId": "verifyMeter",
        "summary": "Verify a meter number",
        "description": "Look up a meter number before paying. Returns the customer name, address, and meter type. Always call this before `POST /bills/electricity`.\n\nNo money is moved. No PIN required.\n\n## Prepaid vs postpaid\n- **Prepaid** — customer pays before consuming. A token is generated on successful payment and loaded onto the meter.\n- **Postpaid** — customer pays monthly bill. No token is generated.",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["disco", "meter_number", "meter_type"],
                "properties": {
                  "disco":        { "type": "string", "description": "DISCO ID from GET /bills/electricity/discos", "example": "ikeja-electric" },
                  "meter_number": { "type": "string", "minLength": 5, "maxLength": 20, "description": "Meter number printed on the meter or bill", "example": "12345678901" },
                  "meter_type":   { "type": "string", "enum": ["prepaid", "postpaid"] }
                }
              },
              "examples": {
                "prepaid_ikeja":   { "summary": "Ikeja Electric prepaid meter", "value": { "disco": "ikeja-electric", "meter_number": "12345678901", "meter_type": "prepaid" } },
                "postpaid_eko":    { "summary": "Eko Electric postpaid meter", "value": { "disco": "eko-electric",   "meter_number": "10101010101", "meter_type": "postpaid" } },
                "prepaid_abuja":   { "summary": "Abuja Electric prepaid meter", "value": { "disco": "abuja-electric", "meter_number": "54321098765", "meter_type": "prepaid" } }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Meter verified. Confirm the customer name with the user before proceeding to payment.",
            "content": {
              "application/json": {
                "schema": { "type": "object", "properties": { "success": { "type": "boolean" }, "data": { "$ref": "#/components/schemas/MeterVerification" }, "meta": { "nullable": true }, "error": { "nullable": true } } },
                "examples": {
                  "prepaid":  { "summary": "Prepaid meter verified", "value": { "success": true, "data": { "customer_name": "KINGSLEY CHIBUIKE", "customer_address": "14 Admiralty Way, Lekki Phase 1", "meter_type": "prepaid" }, "meta": null, "error": null } },
                  "postpaid": { "summary": "Postpaid meter verified", "value": { "success": true, "data": { "customer_name": "ADAEZE OKAFOR", "customer_address": "5 Allen Avenue, Ikeja", "meter_type": "postpaid" }, "meta": null, "error": null } }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "422": { "description": "Invalid meter number or DISCO could not verify.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" }, "example": { "success": false, "data": null, "meta": null, "error": { "code": "VALIDATION_ERROR", "message": "Could not verify meter: Invalid meter number" } } } } }
        }
      }
    },
    "/bills/electricity": {
      "post": {
        "tags": ["Bills — Electricity"],
        "operationId": "payElectricity",
        "summary": "Pay electricity bill",
        "description": "Pay an electricity bill for any Nigerian DISCO.\n\n## Flow\n1. `GET /bills/electricity/discos` — user selects their DISCO\n2. `POST /bills/electricity/verify` — confirm meter number, get customer name\n3. User enters amount and PIN\n4. `POST /bills/electricity` — payment executed\n\n## Prepaid token\nFor prepaid meters, a token is returned in `purchased_code` and `units` on the bill record after delivery. Display this prominently — the user needs it to load units onto their meter.\n\n## Minimum amount\nMinimum electricity payment is ₦500 (50,000 kobo).",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["disco", "meter_number", "meter_type", "amount_kobo", "phone", "pin"],
                "properties": {
                  "disco":          { "type": "string", "description": "DISCO ID from GET /bills/electricity/discos", "example": "ikeja-electric" },
                  "meter_number":   { "type": "string", "minLength": 5, "maxLength": 20, "description": "Must match what was used in verify", "example": "12345678901" },
                  "meter_type":     { "type": "string", "enum": ["prepaid", "postpaid"] },
                  "amount_kobo":    { "type": "integer", "minimum": 50000, "description": "Amount in kobo. Minimum ₦500 (50,000 kobo).", "example": 500000 },
                  "phone":          { "type": "string", "description": "Contact phone number for receipt", "example": "08012345678" },
                  "customer_name":  { "type": "string", "description": "Optional — customer name from verify for display", "example": "KINGSLEY CHIBUIKE" },
                  "pin":            { "type": "string", "pattern": "^\\d{4}$" }
                }
              },
              "examples": {
                "prepaid_5k":    { "summary": "Prepaid ₦5,000", "value": { "disco": "ikeja-electric", "meter_number": "12345678901", "meter_type": "prepaid", "amount_kobo": 500000, "phone": "08012345678", "customer_name": "KINGSLEY CHIBUIKE", "pin": "1234" } },
                "postpaid_10k":  { "summary": "Postpaid ₦10,000", "value": { "disco": "eko-electric", "meter_number": "10101010101", "meter_type": "postpaid", "amount_kobo": 1000000, "phone": "08012345678", "pin": "1234" } },
                "prepaid_20k":   { "summary": "Prepaid ₦20,000", "value": { "disco": "abuja-electric", "meter_number": "54321098765", "meter_type": "prepaid", "amount_kobo": 2000000, "phone": "08012345678", "pin": "1234" } }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Electricity payment successful. For prepaid, `purchased_code` contains the meter token.",
            "content": {
              "application/json": {
                "examples": {
                  "prepaid": {
                    "summary": "Prepaid — token generated",
                    "value": {
                      "success": true,
                      "data": {
                        "id": "uuid", "category": "electricity", "service_id": "ikeja-electric",
                        "transaction_number": "TXN-D4E5F6", "reference": "BILL-20260519-D4E5F6",
                        "status": "delivered", "amount_kobo": "500000", "fee_kobo": "0",
                        "narration": "ikeja-electric electricity — meter ****8901",
                        "recipient": { "meter_number": "12345678901", "meter_type": "prepaid", "disco": "ikeja-electric" },
                        "purchased_code": "1234-5678-9012-3456",
                        "units": "109.9 kWh",
                        "created_at": "2026-05-19T10:15:00.000Z", "completed_at": "2026-05-19T10:15:05.000Z"
                      },
                      "meta": null, "error": null
                    }
                  },
                  "postpaid": {
                    "summary": "Postpaid — no token",
                    "value": {
                      "success": true,
                      "data": {
                        "id": "uuid", "category": "electricity", "service_id": "eko-electric",
                        "transaction_number": "TXN-E5F6G7", "reference": "BILL-20260519-E5F6G7",
                        "status": "delivered", "amount_kobo": "1000000", "fee_kobo": "0",
                        "narration": "eko-electric electricity — meter ****0101",
                        "recipient": { "meter_number": "10101010101", "meter_type": "postpaid", "disco": "eko-electric" },
                        "purchased_code": null, "units": null,
                        "created_at": "2026-05-19T10:16:00.000Z", "completed_at": "2026-05-19T10:16:04.000Z"
                      },
                      "meta": null, "error": null
                    }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "description": "Wrong PIN or PIN locked." },
          "409": { "$ref": "#/components/responses/InsufficientFunds" },
          "422": { "$ref": "#/components/responses/ValidationError" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },
    "/bills/education": {
      "post": {
        "tags": ["Bills — Education"],
        "operationId": "payEducation",
        "summary": "Buy WAEC or JAMB pin",
        "description": "Purchase education payment pins.\n\n## Products\n- `waec-registration` — WAEC school registration\n- `waec` — WAEC result checker scratch card\n- `jamb` — JAMB UTME / Direct Entry pin\n\nThe purchased pin(s) are returned in `purchased_code` on the bill record after delivery.",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["product", "amount_kobo", "phone", "pin"],
                "properties": {
                  "product":     { "type": "string", "enum": ["waec-registration", "waec", "jamb"], "description": "Education product type" },
                  "quantity":    { "type": "integer", "minimum": 1, "maximum": 5, "default": 1, "description": "Number of pins to purchase. Max 5 per transaction." },
                  "amount_kobo": { "type": "integer", "positive": true, "description": "Total amount in kobo for all pins", "example": 350000 },
                  "phone":       { "type": "string", "description": "Contact phone number", "example": "08012345678" },
                  "pin":         { "type": "string", "pattern": "^\\d{4}$" }
                }
              },
              "examples": {
                "waec_result":    { "summary": "WAEC result checker", "value": { "product": "waec", "quantity": 1, "amount_kobo": 350000, "phone": "08012345678", "pin": "1234" } },
                "jamb_utme":      { "summary": "JAMB UTME pin", "value": { "product": "jamb", "quantity": 1, "amount_kobo": 470000, "phone": "08012345678", "pin": "1234" } },
                "waec_reg":       { "summary": "WAEC registration", "value": { "product": "waec-registration", "quantity": 1, "amount_kobo": 1690000, "phone": "08012345678", "pin": "1234" } },
                "waec_bulk":      { "summary": "3 WAEC result checkers", "value": { "product": "waec", "quantity": 3, "amount_kobo": 1050000, "phone": "08012345678", "pin": "1234" } }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Education pin purchased. `purchased_code` contains the pin(s).",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "data": {
                    "id": "uuid", "category": "education", "service_id": "waec",
                    "transaction_number": "TXN-F6G7H8", "reference": "BILL-20260519-F6G7H8",
                    "status": "delivered", "amount_kobo": "350000", "fee_kobo": "0",
                    "narration": "WAEC — qty 1",
                    "recipient": { "exam_type": "waec", "quantity": 1, "phone": "08012345678" },
                    "purchased_code": "PIN-WAEC-1234567890",
                    "units": null,
                    "created_at": "2026-05-19T10:20:00.000Z", "completed_at": "2026-05-19T10:20:03.000Z"
                  },
                  "meta": null, "error": null
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "description": "Wrong PIN or PIN locked." },
          "409": { "$ref": "#/components/responses/InsufficientFunds" },
          "422": { "$ref": "#/components/responses/ValidationError" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },
    "/bills": {
      "get": {
        "tags": ["Bills — History"],
        "operationId": "listBills",
        "summary": "List bill transaction history",
        "description": "Returns all bill transactions for the authenticated user, newest first. Filter by category or status.",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "category", "in": "query", "schema": { "type": "string", "enum": ["airtime", "data", "tv", "electricity", "education", "all"], "default": "all" }, "description": "Filter by category" },
          { "name": "status",   "in": "query", "schema": { "type": "string", "enum": ["pending", "processing", "delivered", "failed", "refunded"] }, "description": "Filter by status" },
          { "name": "cursor",   "in": "query", "schema": { "type": "string", "format": "uuid" }, "description": "Pagination cursor from previous `meta.next_cursor`" },
          { "name": "limit",    "in": "query", "schema": { "type": "integer", "default": 20, "maximum": 50 } }
        ],
        "responses": {
          "200": {
            "description": "Bill transaction list.",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "data": [
                    {
                      "id": "uuid-1", "category": "airtime", "service_id": "mtn",
                      "transaction_number": "TXN-A1B2C3", "reference": "BILL-20260519-A1B2C3",
                      "status": "delivered", "amount_kobo": "100000", "fee_kobo": "0",
                      "narration": "MTN airtime top-up for 08012345678",
                      "recipient": { "phone": "08012345678", "network": "mtn" },
                      "purchased_code": null, "units": null,
                      "created_at": "2026-05-19T10:00:00.000Z", "completed_at": "2026-05-19T10:00:02.000Z"
                    },
                    {
                      "id": "uuid-2", "category": "electricity", "service_id": "ikeja-electric",
                      "transaction_number": "TXN-D4E5F6", "reference": "BILL-20260519-D4E5F6",
                      "status": "delivered", "amount_kobo": "500000", "fee_kobo": "0",
                      "narration": "ikeja-electric electricity — meter ****8901",
                      "recipient": { "meter_number": "12345678901", "meter_type": "prepaid", "disco": "ikeja-electric" },
                      "purchased_code": "1234-5678-9012-3456", "units": "109.9 kWh",
                      "created_at": "2026-05-19T10:15:00.000Z", "completed_at": "2026-05-19T10:15:05.000Z"
                    }
                  ],
                  "meta": { "next_cursor": null, "limit": 20 },
                  "error": null
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/bills/{id}": {
      "get": {
        "tags": ["Bills — History"],
        "operationId": "getBill",
        "summary": "Get bill transaction detail",
        "description": "Returns full detail for a single bill transaction. For electricity prepaid payments, `purchased_code` contains the meter token and `units` contains the credited kWh.",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" }, "description": "Bill transaction ID" }
        ],
        "responses": {
          "200": {
            "description": "Bill transaction detail.",
            "content": {
              "application/json": {
                "schema": { "type": "object", "properties": { "success": { "type": "boolean" }, "data": { "$ref": "#/components/schemas/BillRecord" }, "meta": { "nullable": true }, "error": { "nullable": true } } }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/bills/{id}/requery": {
      "post": {
        "tags": ["Bills — History"],
        "operationId": "requeryBill",
        "summary": "Manually requery bill status from VTPass",
        "description": "Re-check the status of a pending bill transaction directly with VTPass. Useful when a transaction has been `pending` longer than expected.\n\nThis is called automatically by the system at 30s, 60s, and 120s intervals for all pending transactions. Use this endpoint if the user wants an immediate update.\n\nIf VTPass confirms delivery, the status is updated to `delivered` immediately. If still pending, the status is unchanged.",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" }, "description": "Bill transaction ID" }
        ],
        "responses": {
          "200": {
            "description": "Updated bill record.",
            "content": {
              "application/json": {
                "schema": { "type": "object", "properties": { "success": { "type": "boolean" }, "data": { "$ref": "#/components/schemas/BillRecord" }, "meta": { "nullable": true }, "error": { "nullable": true } } },
                "examples": {
                  "now_delivered": { "summary": "VTPass confirmed delivery", "value": { "success": true, "data": { "id": "uuid", "status": "delivered", "completed_at": "2026-05-19T10:05:30.000Z" }, "meta": null, "error": null } },
                  "still_pending": { "summary": "Still pending", "value": { "success": true, "data": { "id": "uuid", "status": "pending", "completed_at": null }, "meta": null, "error": null } }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    }
  }
}

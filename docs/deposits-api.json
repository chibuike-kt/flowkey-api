    "/deposits/card": {
      "post": {
        "tags": ["Deposits"],
        "operationId": "initiateCardDeposit",
        "summary": "Deposit via saved card",
        "description": "Charge a saved card to fund the wallet.\n\nThe wallet is **not** funded immediately — the charge is processed asynchronously by Paystack. The response status will be `pending`. Poll `GET /deposits` or listen for push notifications for the final status.\n\n## Lifecycle\n\n```\nPOST /deposits/card → 201 { status: \"pending\" }\n  ↓ (Paystack processes, 2-5 seconds)\n  → status: \"completed\" (Paystack webhooks FlowKey → wallet credited)\n     OR\n  → status: \"failed\" (card declined — wallet not affected)\n```\n\n## PIN requirement\n\nTransaction PIN is required to authorize the charge. This prevents unauthorized charges if someone else picks up the device.\n\n## Minimum amount\n\n₦100 (10,000 kobo).",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["card_id", "amount_kobo", "pin"],
                "properties": {
                  "card_id": {
                    "type": "string",
                    "format": "uuid",
                    "description": "ID of the saved card to charge. Get this from `GET /cards`."
                  },
                  "amount_kobo": {
                    "type": "integer",
                    "minimum": 10000,
                    "description": "Amount to deposit in kobo. Minimum 10,000 (₦100)."
                  },
                  "pin": {
                    "type": "string",
                    "pattern": "^\\d{4}$",
                    "description": "User's 4-digit transaction PIN."
                  }
                }
              },
              "example": {
                "card_id":     "9b1deb4d-3b7d-4bad-9bdd-2b0d7b3dcb6d",
                "amount_kobo": 500000,
                "pin":         "1234"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Deposit initiated. Status is `pending` — Paystack will confirm asynchronously.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/SuccessResponse" },
                    { "properties": { "data": { "$ref": "#/components/schemas/DepositRecord" } } }
                  ]
                },
                "example": {
                  "success": true,
                  "data": {
                    "id":              "2b3c4d5e-6f7a-8b9c-0d1e-2f3a4b5c6d7e",
                    "wallet_id":       "7c9e6679-7425-40de-944b-e07fc1f90ae7",
                    "channel":         "card",
                    "status":          "pending",
                    "amount_kobo":     "500000",
                    "fee_kobo":        "0",
                    "net_amount_kobo": "500000",
                    "reference":       "DEP-20260512-A1B2C3",
                    "provider_ref":    null,
                    "narration":       "Card deposit ****4321",
                    "card_id":         "9b1deb4d-3b7d-4bad-9bdd-2b0d7b3dcb6d",
                    "created_at":      "2026-05-12T10:00:00.000Z",
                    "completed_at":    null
                  },
                  "meta": null,
                  "error": null
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": {
            "description": "Wrong PIN, or card does not belong to this user.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "success": false, "data": null, "meta": null, "error": { "code": "INVALID_CREDENTIALS", "message": "Incorrect transaction PIN." } }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    },
    "/test/deposit": {
      "post": {
        "tags": ["Test"],
        "operationId": "testDeposit",
        "summary": "Instant test deposit",
        "description": "⚠️ **Development and staging only. Returns 403 in production.**\n\nInstantly fund the wallet with any amount — no card, no virtual account, no webhook. Use this during development to test wallet balance, transfers, and any feature that requires a funded wallet.\n\n## To remove for production\n1. Delete `src/features/deposits/test-deposit.router.ts`\n2. Remove the two lines in `src/app.ts` that import and mount `testDepositRouter`\n\nThe endpoint is also blocked at the handler level when `NODE_ENV=production`, as a second safety net.",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["amount_kobo"],
                "properties": {
                  "amount_kobo": {
                    "type": "integer",
                    "minimum": 100,
                    "description": "Amount to credit in kobo. Minimum 100 (₦1).",
                    "example": 5000000
                  },
                  "narration": {
                    "type": "string",
                    "maxLength": 255,
                    "description": "Optional label for this test deposit.",
                    "example": "Test funding for transfer flow"
                  }
                }
              },
              "examples": {
                "small": {
                  "summary": "₦500",
                  "value": { "amount_kobo": 50000, "narration": "Small test" }
                },
                "standard": {
                  "summary": "₦50,000",
                  "value": { "amount_kobo": 5000000 }
                },
                "large": {
                  "summary": "₦1,000,000",
                  "value": { "amount_kobo": 100000000, "narration": "Large balance test" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Wallet funded instantly.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "data": {
                      "type": "object",
                      "properties": {
                        "reference":   { "type": "string", "example": "TEST-1715515200000-AB1C2D" },
                        "amount_kobo": { "type": "string", "example": "5000000" },
                        "narration":   { "type": "string", "example": "Test deposit — ₦50,000" },
                        "status":      { "type": "string", "enum": ["completed"] },
                        "note":        { "type": "string", "example": "This is a test deposit. Not available in production." }
                      }
                    },
                    "meta":  { "nullable": true, "example": null },
                    "error": { "nullable": true, "example": null }
                  }
                },
                "example": {
                  "success": true,
                  "data": {
                    "reference":   "TEST-1715515200000-AB1C2D",
                    "amount_kobo": "5000000",
                    "narration":   "Test deposit — ₦50,000",
                    "status":      "completed",
                    "note":        "This is a test deposit. Not available in production."
                  },
                  "meta":  null,
                  "error": null
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": {
            "description": "Endpoint disabled in production.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "success": false, "data": null, "meta": null, "error": { "code": "FORBIDDEN", "message": "Test deposits are not available in production." } }
              }
            }
          },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    }
  }
}

{
  "name": "flowkey-api",
  "version": "0.1.0",
  "description": "FlowKey \u00e2\u20ac\u201d wallet-based fintech orchestration platform. Production-grade backend.",
  "main": "dist/server.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:unit": "jest --testPathPatterns='tests/unit'",
    "test:integration": "jest --testPathPatterns='tests/integration' --runInBand",
    "test:concurrency": "jest --testPathPatterns='tests/concurrency' --runInBand",
    "test:failure": "jest --testPathPatterns='tests/failure' --runInBand",
    "test:coverage": "jest --coverage",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:reset": "prisma migrate reset",
    "migrate:resolve": "prisma migrate resolve",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "prepare": "husky",
    "worker:dev": "tsx watch src/workers/index.ts",
    "worker:start": "node dist/workers/index.js",
    "load:smoke": "k6 run tests/load/smoke.js",
    "load:auth": "k6 run tests/load/auth.js",
    "load:wallet": "k6 run tests/load/wallet.js",
    "load:stress": "k6 run tests/load/stress.js",
    "load:spike": "k6 run tests/load/spike.js"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1037.0",
    "@prisma/client": "^6.19.3",
    "argon2": "^0.44.0",
    "bullmq": "^5.76.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.1",
    "firebase-admin": "^13.9.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "nodemailer": "^8.0.7",
    "opossum": "^9.0.0",
    "postgres": "^3.4.9",
    "prisma": "^6.19.3",
    "prom-client": "^15.1.3",
    "rate-limiter-flexible": "^11.0.1",
    "uuid": "^14.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^9.39.4",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.12.2",
    "@types/nodemailer": "^6.4.23",
    "@types/opossum": "^8.1.9",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "jest-mock-extended": "^4.0.1",
    "js-yaml": "^4.1.1",
    "prettier": "^3.8.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}

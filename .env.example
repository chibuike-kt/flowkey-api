# ===========================================================================
# FlowKey API — Environment Variables
# Copy to .env and fill in values. Never commit .env to git.
# ===========================================================================

# ---------------------------------------------------------------------------
# Database — Supabase
# ---------------------------------------------------------------------------

# Pooled URL — port 6543, goes through PgBouncer. Used by the running app.
# Get from: Supabase Dashboard → Settings → Database → Connection string → URI
# Make sure to select "Transaction" mode pooler (port 6543).
DATABASE_URL=postgresql://flowkey:flowkey_dev_password@localhost:5433/flowkey_db

# Direct URL — port 5432, bypasses PgBouncer. Used ONLY by prisma migrate.
# Get from: Supabase Dashboard → Settings → Database → Connection string → URI
# Switch to "Direct connection" tab.
DIRECT_URL=postgresql://flowkey:flowkey_dev_password@localhost:5432/flowkey_db

# Shadow database for prisma migrate dev (can be same Supabase project, different schema)
SHADOW_DATABASE_URL=postgresql://flowkey:flowkey_dev_password@localhost:5433/flowkey_shadow_db

# Connection pool tuning (optional — defaults shown)
# CONNECTION_LIMIT=5    # max Prisma connections per instance (increase for Pro plan)
# POOL_TIMEOUT=10       # seconds to wait for a connection before failing

# ---------------------------------------------------------------------------
# Redis — Upstash or self-hosted
# ---------------------------------------------------------------------------
REDIS_URL=redis://default:[password]@[host]:[port]
REDIS_KEY_PREFIX=fk

# ---------------------------------------------------------------------------
# JWT — RS256 asymmetric keys
# Generate: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem
# Paste the full PEM content including headers.
# ---------------------------------------------------------------------------
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
...
-----END RSA PRIVATE KEY-----"

JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
...
-----END PUBLIC KEY-----"

JWT_ACCESS_TOKEN_TTL=900       # 15 minutes (seconds)
JWT_REFRESH_TOKEN_TTL=2592000  # 30 days (seconds)
JWT_ISSUER=flowkey-api
JWT_AUDIENCE=flowkey-app

# ---------------------------------------------------------------------------
# Admin API key for protected internal endpoints (e.g. feature flags management).
# Must be a long, random string. Generate with: openssl rand -hex 32
# ---------------------------------------------------------------------------
ADMIN_API_KEY=

# ---------------------------------------------------------------------------
# SMTP — email delivery
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="FlowKey <noreply@flowkey.app>"

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
API_VERSION=v1

# ---------------------------------------------------------------------------
# External providers
# ---------------------------------------------------------------------------
PROVIDUS_WEBHOOK_SECRET=your-providus-webhook-secret
PAYSTACK_SECRET_KEY=sk_live_your-paystack-secret-key
PREMBLY_API_BASE_URL=https://api.prembly.com
PREMBLY_API_KEY=your-prembly-api-key

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
ALLOWED_ORIGINS=https://app.flowkey.app,https://admin.flowkey.app
CARD_STUB_FAIL_RATE=0   # 0.1 = 10% simulated card failure rate in dev

# =============================================================================
# FLOWKEY API — ENVIRONMENT VARIABLES REFERENCE
# =============================================================================
# Copy this file to .env for local development.
# .env is gitignored and must NEVER be committed.
# In production, all secrets are resolved from AWS Secrets Manager at startup.
# Non-secret config (ports, node env, etc.) may still use environment variables
# in production via your deployment platform (ECS task definition, etc.).
# =============================================================================

# -----------------------------------------------------------------------------
# RUNTIME
# -----------------------------------------------------------------------------

# Node environment. Options: development | test | production
NODE_ENV=development

# Port the HTTP server listens on
PORT=3000

# API version prefix (do not change without a migration plan)
API_VERSION=v1

# -----------------------------------------------------------------------------
# DATABASE — PostgreSQL
# -----------------------------------------------------------------------------

# Full Postgres connection string.
# Local dev: points to Docker Compose container (see docker-compose.yml).
# Production: AWS RDS connection string, resolved via AWS Secrets Manager.
DATABASE_URL=postgresql://flowkey:flowkey_dev_password@localhost:5433/flowkey_db

# Shadow database for Prisma migrate dev (local dev only, never production)
SHADOW_DATABASE_URL=postgresql://flowkey:flowkey_dev_password@localhost:5433/flowkey_shadow_db

# -----------------------------------------------------------------------------
# REDIS
# -----------------------------------------------------------------------------

# Redis connection URL.
# Local dev: points to Docker Compose container.
# Production: AWS ElastiCache endpoint.
REDIS_URL=redis://localhost:6380

# Redis key prefix — namespaces all FlowKey keys (prevents collision if Redis is shared)
REDIS_KEY_PREFIX=fk:

# -----------------------------------------------------------------------------
# JWT — RS256 ASYMMETRIC KEYS
# -----------------------------------------------------------------------------

# RSA private key for signing JWTs (PEM format, newlines as \n).
# NEVER commit a real private key. Generate with:
#   openssl genrsa -out private.pem 4096
#   openssl rsa -in private.pem -pubout -out public.pem
# Then copy the PEM content here with literal \n for newlines.
# In production: resolved from AWS Secrets Manager, not this file.
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nREPLACE_ME\n-----END RSA PRIVATE KEY-----"

# RSA public key for verifying JWTs (PEM format, newlines as \n)
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nREPLACE_ME\n-----END PUBLIC KEY-----"

# Access token TTL in seconds. Default: 900 (15 minutes). Do not increase.
JWT_ACCESS_TOKEN_TTL=900

# Refresh token TTL in seconds. Default: 2592000 (30 days)
JWT_REFRESH_TOKEN_TTL=2592000

# JWT issuer claim — identifies this system
JWT_ISSUER=flowkey-api

# JWT audience claim — identifies the intended consumer
JWT_AUDIENCE=flowkey-app

# -----------------------------------------------------------------------------
# SESSION & DEVICE
# -----------------------------------------------------------------------------

# Maximum concurrent device sessions per user
MAX_SESSIONS_PER_USER=5

# -----------------------------------------------------------------------------
# OTP
# -----------------------------------------------------------------------------

# OTP TTL in seconds. 300 = 5 minutes (confirmed)
OTP_TTL_SECONDS=300

# Maximum OTP submission attempts before OTP is invalidated (confirmed: 3)
OTP_MAX_ATTEMPTS=3

# OTP resend rate limit window in seconds (confirmed: 30 minutes = 1800s)
OTP_RESEND_WINDOW_SECONDS=1800

# Maximum OTP resend requests within the window (confirmed: 3)
OTP_RESEND_MAX=3

# -----------------------------------------------------------------------------
# ARGON2ID HASHING PARAMETERS
# These must match the values documented in docs/SECURITY.md.
# Changing these requires a migration plan — existing hashes use the old params.
# -----------------------------------------------------------------------------

ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4
ARGON2_OUTPUT_LENGTH=32

# -----------------------------------------------------------------------------
# RATE LIMITING
# -----------------------------------------------------------------------------

# Global rate limit window in milliseconds (default: 15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Global max requests per window per IP (default: 100 for most endpoints)
RATE_LIMIT_MAX_REQUESTS=100

# Auth endpoint rate limit — stricter (per IP)
AUTH_RATE_LIMIT_MAX=20

# -----------------------------------------------------------------------------
# EMAIL — NODEMAILER (development/staging)
# In production this will be replaced by Twilio SendGrid or equivalent.
# Configure a real SMTP provider or use Ethereal (https://ethereal.email) locally.
# -----------------------------------------------------------------------------

SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=REPLACE_ME
SMTP_PASS=REPLACE_ME
SMTP_FROM="FlowKey <noreply@flowkey.ng>"

# -----------------------------------------------------------------------------
# FIREBASE CLOUD MESSAGING (Push Notifications)
# -----------------------------------------------------------------------------

# Path to Firebase service account JSON file (local dev only).
# In production: contents resolved from AWS Secrets Manager as a JSON string.
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json

# Firebase project ID
FIREBASE_PROJECT_ID=REPLACE_ME

# -----------------------------------------------------------------------------
# PREMBLY (KYC — Identity Verification)
# -----------------------------------------------------------------------------

# Prembly API base URL — confirm from Prembly documentation before Phase 13
PREMBLY_API_BASE_URL=https://api.prembly.com/identitypass/verification

# Prembly API key — resolved from AWS Secrets Manager in production
PREMBLY_API_KEY=REPLACE_ME

# Prembly webhook secret for HMAC verification — resolved from AWS Secrets Manager
PREMBLY_WEBHOOK_SECRET=REPLACE_ME

# Prembly request timeout in milliseconds (confirmed: 15 seconds)
PREMBLY_TIMEOUT_MS=15000

# Circuit breaker: consecutive failures before opening
PREMBLY_CIRCUIT_BREAKER_THRESHOLD=5

# Circuit breaker: cooldown in milliseconds before half-open probe
PREMBLY_CIRCUIT_BREAKER_COOLDOWN_MS=60000

# -----------------------------------------------------------------------------
# PROVIDUS BANK (Bank Withdrawals)
# UNCONFIRMED — placeholder values. Will be populated when we reach Phase 9.
# -----------------------------------------------------------------------------

PROVIDUS_API_BASE_URL=UNCONFIRMED_SEE_PHASE_9
PROVIDUS_CLIENT_ID=REPLACE_ME
PROVIDUS_CLIENT_SECRET=REPLACE_ME
PROVIDUS_WEBHOOK_SECRET=REPLACE_ME
PROVIDUS_TIMEOUT_MS=10000
PROVIDUS_WEBHOOK_SLA_MS=600000

# -----------------------------------------------------------------------------
# AWS — SECRETS MANAGER
# In development: these are not used (config falls back to dotenv).
# In production: the application uses these to bootstrap the Secrets Manager client.
# NEVER put real AWS credentials here. Use IAM roles on your compute (ECS/EC2).
# For local dev against real AWS: use AWS CLI profiles or environment credentials.
# -----------------------------------------------------------------------------

# AWS region for Secrets Manager.
# Default: af-south-1 (Cape Town) — adjust to your actual deployment region.
# PLACEHOLDER: confirm your AWS region before deploying to production.
AWS_REGION=af-south-1

# AWS Secrets Manager secret name/ARN for the production secret bundle
# PLACEHOLDER: set this to your actual Secrets Manager secret name before production deploy
AWS_SECRET_NAME=flowkey/production/api

# -----------------------------------------------------------------------------
# INTERNAL SYSTEM
# -----------------------------------------------------------------------------

# HMAC secret for signing QR code payloads and receipt URLs.
# Minimum 64 hex characters (256 bits). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
QR_HMAC_SECRET=REPLACE_ME_WITH_64_CHAR_HEX

# HMAC secret for signing receipt download URLs
RECEIPT_HMAC_SECRET=REPLACE_ME_WITH_64_CHAR_HEX

# Signed URL TTL for receipt downloads in seconds (confirmed: 72 hours)
RECEIPT_URL_TTL_SECONDS=259200

# -----------------------------------------------------------------------------
# QUEUE — BULLMQ
# -----------------------------------------------------------------------------

# Queue name prefix — namespaces all FlowKey queues
QUEUE_PREFIX=flowkey

# Default job retry attempts
QUEUE_DEFAULT_RETRIES=3

# Default job backoff delay in milliseconds
QUEUE_DEFAULT_BACKOFF_MS=5000

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------

# Log level: error | warn | info | debug
LOG_LEVEL=debug

# Log format: json (production) | pretty (development)
LOG_FORMAT=pretty

# =============================================================================
# END OF REFERENCE
# =============================================================================
